    {
      "parameters": {
        "jsCode": "// Valida e filtra apenas campos com valor\nconst p = $input.first().json;\n\nif (!p.os_codigo) {\n  throw new Error('ERRO: os_codigo e OBRIGATORIO para salvar contexto.');\n}\n\nconst out = { os_codigo: String(p.os_codigo) };\n\nconst camposStr = [\n  'os_id_bomsaldo', 'conversa_id',\n  'tecnico_id', 'tecnico_nome', 'tecnico_whatsapp',\n  'cliente_nome', 'cliente_codigo', 'cliente_endereco',\n  'equipamento', 'equipamento_codigo', 'marca', 'modelo',\n  'defeito', 'causa', 'solucao', 'relatorio_tecnico',\n  'tipo_servico', 'servico_nome', 'servico_codigo', 'observacoes_orientacao',\n  'tipo_pagamento', 'forma_pagamento_id',\n  'hora_entrada', 'hora_saida',\n  'link_pasta_drive',\n  'status_os', 'fase_ia', 'motivo_cancelamento'\n];\n\nfor (const campo of camposStr) {\n  if (p[campo] !== undefined && p[campo] !== null && p[campo] !== '') {\n    out[campo] = String(p[campo]);\n  }\n}\n\n// Campos numericos\nif (p.valor_total !== undefined && p.valor_total !== null && p.valor_total !== '') {\n  out.valor_total = Number(p.valor_total) || 0;\n}\n\n// Campo boolean\nif (p.em_garantia !== undefined && p.em_garantia !== null && p.em_garantia !== '') {\n  out.em_garantia = (p.em_garantia === 'true' || p.em_garantia === true);\n}\n\n// Resolução de IDs do Bom Saldo para Produtos e Serviços pelo Nome (se IDs ausentes)\nconst resolverProdutos = async (val) => {\n  if (!val || val === '') return null;\n  let arr = [];\n  if (Array.isArray(val)) arr = val;\n  else if (typeof val === 'string') {\n    try { arr = JSON.parse(val); } catch { return null; }\n  }\n  if (!Array.isArray(arr) || arr.length === 0) return null;\n\n  const resolved = [];\n  for (const prod of arr) {\n    let pid = prod.produto_id || prod.id;\n    let varId = prod.variacao_id;\n    if (!pid && prod.nome) {\n      try {\n        const bsResp = await $helpers.httpRequest({\n          method: 'GET',\n          url: 'https://bomsaldo.com/api/produtos/',\n          headers: {\n            'access-token': '698a9f9846f8ea6d2b3a59d5cb99f4a9e32c17e8',\n            'secret-access-token': '874ac39b56dcf8a7b87e9bdafe88f833d0155c7a'\n          },\n          qs: { nome: prod.nome, ativo: '1', limit: '5' }\n        });\n        const items = bsResp.data || bsResp;\n        if (Array.isArray(items) && items.length > 0) {\n          pid = String(items[0].id || '');\n          if (items[0].variacoes && Array.isArray(items[0].variacoes) && items[0].variacoes[0]) {\n            varId = String(items[0].variacoes[0].id || items[0].variacoes[0].variacao?.id || '');\n          }\n        }\n      } catch(e) {}\n    }\n    resolved.push({\n      produto_id: pid || '',\n      id: pid || '',\n      variacao_id: varId || '',\n      nome: prod.nome || '',\n      quantidade: String(prod.quantidade || '1'),\n      valor_venda: prod.valor_venda !== undefined && prod.valor_venda !== null ? String(prod.valor_venda) : '0',\n      origem: prod.origem || 'BomSaldo'\n    });\n  }\n  return JSON.stringify(resolved);\n};\n\nconst resolverServicos = async (val) => {\n  if (!val || val === '') return null;\n  let arr = [];\n  if (Array.isArray(val)) arr = val;\n  else if (typeof val === 'string') {\n    try { arr = JSON.parse(val); } catch { return null; }\n  }\n  if (!Array.isArray(arr) || arr.length === 0) return null;\n\n  const resolved = [];\n  for (const svc of arr) {\n    let sid = svc.servico_id || svc.id;\n    if (!sid && svc.nome) {\n      try {\n        const bsResp = await $helpers.httpRequest({\n          method: 'GET',\n          url: 'https://bomsaldo.com/api/servicos/',\n          headers: {\n            'access-token': '698a9f9846f8ea6d2b3a59d5cb99f4a9e32c17e8',\n            'secret-access-token': '874ac39b56dcf8a7b87e9bdafe88f833d0155c7a'\n          },\n          qs: { nome: svc.nome, ativo: '1', limit: '5' }\n        });\n        const items = bsResp.data || bsResp;\n        if (Array.isArray(items) && items.length > 0) {\n          sid = String(items[0].id || '');\n        }\n      } catch(e) {}\n    }\n    resolved.push({\n      servico_id: sid || '',\n      id: sid || '',\n      nome: svc.nome || '',\n      quantidade: String(svc.quantidade || '1'),\n      valor_venda: svc.valor_venda !== undefined && svc.valor_venda !== null ? String(svc.valor_venda) : '0',\n      origem: svc.origem || 'BomSaldo'\n    });\n  }\n  return JSON.stringify(resolved);\n};\n\nconst pj = await resolverProdutos(p.produtos_json);\nif (pj) out.produtos_json = pj;\n\nconst sj = await resolverServicos(p.servicos_json);\nif (sj) out.servicos_json = sj;\n\n// Flag interna\nout._tem_os_id = !!(out.os_id_bomsaldo && out.os_id_bomsaldo !== '');\n\nreturn [{ json: out }];"
      },
