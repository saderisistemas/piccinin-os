        "jsonBody": "={{ JSON.stringify({ os_id: $('Buscar OS Supabase').first().json.id || null, os_codigo: $('Trigger').first().json.os_codigo, os_id_bomsaldo: $('Buscar OS Supabase').first().json.os_id_bomsaldo || '', conversa_id: $('Buscar OS Supabase').first().json.conversa_id || '', tecnico_id: $('Buscar OS Supabase').first().json.tecnico_id || '', tecnico_nome: $('Buscar OS Supabase').first().json.tecnico_nome || '', cliente_nome: $('Buscar OS Supabase').first().json.cliente_nome || $('Trigger').first().json.cliente_nome || '', arquivo_nome: $('Retornar Link').first().json.arquivo_nome || $('Retornar Link').first().json.arquivo_id || '', arquivo_url: $('Retornar Link').first().json.arquivo_url || $('Retornar Link').first().json.link_arquivo || '', tipo_arquivo: $('Retornar Link').first().json.tipo_arquivo || 'image/jpeg', url_origem: $('Trigger').first().json.urlImagem, drive_file_id: $('Retornar Link').first().json.arquivo_id || '', drive_folder_id: $('Retornar Link').first().json.drive_folder_id || '', link_arquivo: $('Retornar Link').first().json.link_arquivo || '', link_pasta: $('Retornar Link').first().json.link_drive || '', descricao: $('Trigger').first().json.descricao || '', criado_em: new Date().toISOString() }) }}",
