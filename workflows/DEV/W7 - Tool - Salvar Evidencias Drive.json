    {
      "parameters": {
        "jsCode": "const arquivo = $input.first().json;\nconst trigger = $('Trigger').first().json;\nconst osCodigo = trigger.os_codigo;\nconst clienteNome = trigger.cliente_nome || '';\nconst folderId = $('Merge Upload').first().json.folderId || $('Resolver Pasta OS').first().json.folder_id_existente || '';\nconst linkPasta = folderId ? `https://drive.google.com/drive/folders/${folderId}` : '';\nconst linkArquivo = arquivo.webViewLink || arquivo.webContentLink || (arquivo.id ? `https://drive.google.com/file/d/${arquivo.id}/view` : '');\nconst tipoArquivo = arquivo.mimeType || 'image/jpeg';\nreturn [{ json: {\n  resultado: `📁 Evidência salva no Drive!\\nOS: #${osCodigo}${clienteNome ? ' - ' + clienteNome : ''}\\nArquivo: ${arquivo.name || arquivo.id || 'arquivo'}\\nLink do arquivo: ${linkArquivo || 'indisponivel'}\\nLink da pasta: ${linkPasta || 'indisponivel'}` ,\n  link_drive: linkPasta,\n  link_arquivo: linkArquivo,\n  arquivo_id: arquivo.id || null,\n  drive_folder_id: folderId || null,\n  tipo_arquivo: tipoArquivo,\n  os_codigo: osCodigo,\n  cliente_nome: clienteNome,\n  arquivo_nome: arquivo.name || null,\n  arquivo_url: linkArquivo || null,\n  descricao: trigger.descricao || ''\n} }];"
      },
