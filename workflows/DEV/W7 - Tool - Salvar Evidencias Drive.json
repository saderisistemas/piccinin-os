    {
      "parameters": {
        "jsCode": "const link = $('Retornar Link').first().json || {};\nconst os = $('Buscar OS Supabase').first().json || {};\nconst update = $('Atualizar Evidencia Supabase').first().json || {};\nconst evidencia = $('Inserir Evidencia Supabase').first().json || {};\nreturn [{\n  json: {\n    sucesso: true,\n    resultado: link.resultado || `Evidência registrada na OS ${link.os_codigo || os.os_codigo || ''}.`,\n    os_codigo: link.os_codigo || os.os_codigo || null,\n    os_id_bomsaldo: os.os_id_bomsaldo || null,\n    os_id: os.id || null,\n    cliente_nome: link.cliente_nome || os.cliente_nome || null,\n    link_drive: link.link_drive || null,\n    link_arquivo: link.link_arquivo || null,\n    arquivo_id: link.arquivo_id || null,\n    drive_folder_id: link.drive_folder_id || null,\n    evidencia_id: evidencia.id || null,\n    qtd_evidencias: update.qtd_evidencias ?? os.qtd_evidencias ?? null,\n    supabase_update: update,\n    evidencia\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2592,
        544
      ],
      "id": "150bafe5-62ca-4385-8dcd-d4f125119e85",
      "name": "Consolidar Resultado"
